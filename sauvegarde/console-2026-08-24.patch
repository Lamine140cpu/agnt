+    const f = new URLSearchParams(location.hash.slice(1));
+
+    // L'ÉCHEC AUSSI REVIENT DANS LE FRAGMENT. Un lien périmé renvoie
+    // `#error=access_denied&error_code=otp_expired`, que le serveur ne voit
